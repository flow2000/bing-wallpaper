# Cloudflare Pages / Workers 静态资源缓存策略
# 此文件由 webpack 从 static/ 复制到 dist/ 根目录

# 带哈希的静态资源（JS/CSS/图片）永久缓存
/static/*
  Cache-Control: public, max-age=31536000, immutable

# HTML 页面短缓存，兼顾更新与性能
/*.html
  Cache-Control: public, max-age=3600

# sitemap 每天缓存
/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=86400

# 首页短缓存
/
  Cache-Control: public, max-age=3600
