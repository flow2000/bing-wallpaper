{
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "NODE_OPTIONS": "--openssl-legacy-provider"
    }
  },
  "rewrites": [
    {
      "source": "/wallpaper/detail/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/region/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!static|.*\\..*|_next).*)",
      "destination": "/index.html"
    }
  ]
}
